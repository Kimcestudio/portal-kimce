rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn() && (
        userDoc(request.auth.uid).data.role == "admin" ||
        userDoc(request.auth.uid).data.role == "ADMIN"
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /userDirectory/{uid} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /workSchedules/{scheduleId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /finance_movements/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /expenses/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /transfers/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /collaboratorPayments/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /collaborators/{docId} {
      allow read, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /clientDocuments/{docId} {
      allow read, list: if true;
      allow write: if isAdmin();
    }

    match /calendarHolidays/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /calendarEvents/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /orgTeams/{docId} {
      allow read, list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{uid}/hours/{hourId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // collectionGroup query coverage for admin (collectionGroup requires /{path=**}/ syntax)
    match /{path=**}/hours/{hourId} {
      allow read, list, write, delete: if isAdmin();
    }

    match /hourRequests/{requestId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow read, list: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow read, list, update, delete: if isAdmin();
    }

    match /extraActivities/{activityId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow read, list: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow update: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow read, list, update, delete: if isAdmin();
    }

    match /users/{uid}/hourRequests/{requestId} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, list: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow read, list, update, delete: if isAdmin();
    }

    match /users/{uid}/extraActivities/{activityId} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, list: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow read, list, update, delete: if isAdmin();
    }

    match /correctionRequests/{docId} {
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow read, list, update, delete: if isAdmin();
    }

    match /timeEntries/{docId} {
      allow read, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // CM Hub — Content management tool (internal use, signed-in only)
    match /cmhub_brands/{docId} {
      allow read, list: if isSignedIn() || resource.data.calendarShareEnabled == true;
      allow write: if isSignedIn();
    }
    match /cmhub_contents/{docId} {
      allow read, list: if isSignedIn() || get(/databases/$(database)/documents/cmhub_brands/$(resource.data.brandId)).data.calendarShareEnabled == true;
      allow write: if isSignedIn();
    }
    match /cmhub_tareas_diarias/{docId} {
      allow read, list, write: if isSignedIn();
    }
    match /cmhub_proyectos/{docId} {
      allow read, list, write: if isSignedIn();
    }
    match /cmhub_mensajes_sala/{docId} {
      allow read, list, write: if isSignedIn();
    }
    match /hubActividades/{docId} {
      allow read, list, write: if isSignedIn();
    }

    // Notificaciones por usuario — solo las propias; las crea la Cloud Function (Admin SDK).
    match /notifications/{docId} {
      allow read, list, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }
  }
}
