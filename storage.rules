rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Capturas del brief de flujos — solo equipo KIMCE puede subir; lectura pública para mostrarlas.
    match /hubFlujosCapturas/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
